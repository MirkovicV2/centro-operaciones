{
  "_comentario": "Plantilla de permisos por rol para trabajadores Claude Code lanzados por Orca. Copiala a <CHECKOUT>/.claude/settings.local.json del checkout aislado y sustituye <RAIZ> (carpeta del centro de operaciones), <CHECKOUT> (ruta absoluta del checkout), <PUERTO> (CENTRO_OPERATIONS_PORT) y <ORCA_CLI> (ruta del ejecutable orca que usa Orca; en Ubuntu suele ser ~/.config/orca/linux-orca-cli-shim/orca). No se aplica automaticamente a checkouts ajenos. Las reglas Bash solo reconocen comandos simples: el brief pide a los trabajadores un comando por llamada, sin ; && | variables ni cd.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(//<CHECKOUT>/**)",
      "Edit(//<CHECKOUT>/**)",
      "Write(//<CHECKOUT>/**)",
      "Read(//<RAIZ>/data/dispatch-specs/**)",
      "Read(//<RAIZ>/data/stage-reports/**)",
      "Bash(sha256sum:*)",
      "Bash(wc -c:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(npm test:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git branch --show-current)",
      "Bash(curl -sS -X POST http://127.0.0.1:<PUERTO>/api/jobs/*/context *)",
      "Bash(curl -s -X POST http://127.0.0.1:<PUERTO>/api/jobs/*/context *)",
      "Bash(<ORCA_CLI> orchestration send *--type worker_done*)",
      "Bash(<ORCA_CLI> orchestration ask *)",
      "Bash(<ORCA_CLI> orchestration dispatch-show *)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git * push*)",
      "Bash(git * commit*)",
      "Bash(gh:*)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(wget:*)",
      "Bash(curl https://*)",
      "Bash(curl * https://*)",
      "Bash(curl http://localhost*)",
      "Bash(curl * http://localhost*)",
      "WebFetch",
      "WebSearch",
      "Edit(//<RAIZ>/data/**)",
      "Write(//<RAIZ>/data/**)",
      "Edit(//<RAIZ>/.artifacts/**)",
      "Write(//<RAIZ>/.artifacts/**)",
      "Bash(<ORCA_CLI> orchestration worker-start:*)",
      "Bash(<ORCA_CLI> orchestration run-create:*)",
      "Bash(<ORCA_CLI> orchestration task-create:*)",
      "Bash(<ORCA_CLI> orchestration dispatch *)",
      "Bash(<ORCA_CLI> orchestration worker-stop:*)",
      "Bash(<ORCA_CLI> orchestration worker-abandon:*)",
      "Bash(<ORCA_CLI> orchestration coordinator-start:*)",
      "Bash(<ORCA_CLI> orchestration send *--type dispatch*)",
      "Bash(<ORCA_CLI> orchestration send *--type handoff*)",
      "Bash(<ORCA_CLI> worktree:*)",
      "Bash(<ORCA_CLI> agent:*)",
      "Bash(<ORCA_CLI> terminal:*)",
      "Bash(<ORCA_CLI> repo:*)"
    ]
  }
}
